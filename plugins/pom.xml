<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.jnimble</groupId>
        <artifactId>jnimble-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../jnimble-framework/pom.xml</relativePath>
    </parent>

    <artifactId>jnimble-plugins</artifactId>
    <packaging>pom</packaging>
    <name>JNimble Business Plugins</name>

    <modules>
        <module>jnimble-plugin-demo-crm</module>
        <module>jnimble-plugin-menu-manager</module>
        <module>jnimble-plugin-order-core</module>
        <module>jnimble-plugin-order-table</module>
        <module>jnimble-plugin-payment</module>
        <module>jnimble-plugin-printer-core</module>
        <module>jnimble-plugin-printer-feie</module>
        <module>jnimble-plugin-scan-consumer</module>
    </modules>

    <!--
        开发期输出目录:插件 JAR 打包后直接落到框架 starter 的插件目录,
        由 starter 的 PluginDirectoryInitializer/PluginDirectoryWatcher 以 JAR 方式
        安装/热部署。这样 starter 无需依赖任何业务插件(classpath 保持干净),
        依赖方向仍是"插件侧 -> 平台"。
        覆盖方式:mvn -Dplugin.deploy.dir=/abs/path package
    -->
    <properties>
        <plugin.deploy.dir>${project.basedir}/../../jnimble-framework/jnimble-starter/data/plugins</plugin.deploy.dir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>deploy-plugin-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${plugin.deploy.dir}"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="${plugin.deploy.dir}"
                                      overwrite="true"
                                      failonerror="false"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        本仓库内部模块互引的版本统一在此声明,便于一处修改。
        jnimble-plugin-* 跟随本仓库 0.1.0-SNAPSHOT。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.jnimble</groupId>
                <artifactId>jnimble-plugin-demo-crm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jnimble</groupId>
                <artifactId>jnimble-plugin-menu-manager</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jnimble</groupId>
                <artifactId>jnimble-plugin-order-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jnimble</groupId>
                <artifactId>jnimble-plugin-order-table</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jnimble</groupId>
                <artifactId>jnimble-plugin-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jnimble</groupId>
                <artifactId>jnimble-plugin-printer-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jnimble</groupId>
                <artifactId>jnimble-plugin-printer-feie</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jnimble</groupId>
                <artifactId>jnimble-plugin-scan-consumer</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
